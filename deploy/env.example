# ==============================================================================
# Cadence Infrastructure Environment Configuration (deploy/env.example)
#
# Copy this file to deploy/.env if overriding default docker-compose environment.
# Values here configure container credentials and ports for local services.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Service (cadence-postgres)
# ------------------------------------------------------------------------------
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_password
POSTGRES_DB=cadence_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Service (cadence-redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage (cadence-minio)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets auto-created by the minio-create-buckets setup container
MINIO_RECORDINGS_BUCKET=cadence-recordings
MINIO_KNOWLEDGE_BUCKET=cadence-knowledge

# ------------------------------------------------------------------------------
# LiveKit WebRTC Real-Time Media Server (cadence-livekit)
# ------------------------------------------------------------------------------
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_PORT_RANGE=50000-50020
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
