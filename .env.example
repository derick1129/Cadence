# ==============================================================================
# Cadence Platform Root Environment Configuration (.env.example)
#
# Copy this file to .env and adjust values for your local or production setup.
# Never commit .env containing real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Core Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Application secret key used for signing session cookies and JWT access tokens (min 32 chars)
SECRET_KEY=cadence-default-insecure-secret-key-change-in-prod-at-least-32-chars

# Shared secret token for authenticating internal worker API requests (X-Internal-Service-Token)
INTERNAL_SERVICE_TOKEN=cadence-default-internal-token-change-in-prod

# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (asyncpg driver required for asyncio)
DATABASE_URL=postgresql+asyncpg://cadence:cadence_password@localhost:5432/cadence_dev

# Redis connection URL (used for concurrency counters, rate limits, and pub/sub)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO locally / AWS S3 in production)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_RECORDINGS_BUCKET=cadence-recordings
S3_KNOWLEDGE_BUCKET=cadence-knowledge

# ------------------------------------------------------------------------------
# LiveKit Real-Time WebRTC Media Server
# ------------------------------------------------------------------------------
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Providers
# ------------------------------------------------------------------------------
# Deepgram Nova-2 (default low-latency STT)
DEEPGRAM_API_KEY=mock-deepgram-key

# ------------------------------------------------------------------------------
# Large Language Model (LLM) Providers
# ------------------------------------------------------------------------------
# OpenAI (gpt-4o-mini default, gpt-4o for complex reasoning)
OPENAI_API_KEY=mock-openai-key

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Providers
# ------------------------------------------------------------------------------
# Cartesia Sonic English (ultra-low latency default)
CARTESIA_API_KEY=mock-cartesia-key

# ElevenLabs Turbo v2.5 (alternate voice profile)
ELEVENLABS_API_KEY=mock-elevenlabs-key

# ------------------------------------------------------------------------------
# Telephony Carrier & SIP Trunking (Twilio default)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=mock-twilio-sid
TWILIO_AUTH_TOKEN=mock-twilio-token
TWILIO_SIP_DOMAIN=sip.cadence.example.com

# ------------------------------------------------------------------------------
# Billing & Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=mock-stripe-secret-key
STRIPE_WEBHOOK_SECRET=mock-stripe-webhook-secret
